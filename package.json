{
  "name": "magda-kennedy",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/migrate.cjs",
    "build:admin-create": "esbuild scripts/admin-create.ts --bundle --platform=node --target=node22 --format=cjs --alias:server-only=./scripts/server-only-stub.js --outfile=dist/admin-create.cjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- tsx scripts/migrate.ts",
    "admin:create": "NODE_OPTIONS=--conditions=react-server dotenv -e .env -- tsx scripts/admin-create.ts",
    "auth:generate": "esbuild server/auth/cli.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-stub.js --outfile=node_modules/.cache/auth-cli/cli.mjs && dotenv -e .env -- pnpm dlx auth@1.7.7 generate --config node_modules/.cache/auth-cli/cli.mjs --output server/db/schema/auth.ts -y && node scripts/auth-schema-tz.mjs server/db/schema/auth.ts && prettier --write server/db/schema/auth.ts",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/e2e-seed.ts",
    "test:parity": "playwright test tests/e2e/parity",
    "test:parity:update": "playwright test tests/e2e/parity --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bsmnt/scrollytelling": "^0.3.3",
    "@gsap/react": "^2.1.2",
    "@hono/vercel": "1.0.1",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "gsap": "^3.15.0",
    "hono": "4.13.13",
    "lenis": "^1.3.26",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "nuqs": "^2.10.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "otpauth": "^9.5.2",
    "postcss": "8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
