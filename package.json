{
  "name": "magda-kennedy",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "hero:depth": "npm install --no-save --no-package-lock --prefix node_modules/.cache/hero-depth @huggingface/transformers@4.3.0 && cp scripts/generate-hero-depth.mjs node_modules/.cache/hero-depth/ && node node_modules/.cache/hero-depth/generate-hero-depth.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/migrate.cjs",
    "build:admin-create": "esbuild scripts/admin-create.ts --bundle --platform=node --target=node22 --format=cjs --alias:server-only=./scripts/server-only-stub.js --outfile=dist/admin-create.cjs",
    "start": "next start",
    "email:dev": "email dev --dir emails --port 3030",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- tsx scripts/migrate.ts",
    "build:owner-recover": "esbuild scripts/owner-recover.ts --bundle --platform=node --target=node22 --format=cjs --alias:server-only=./scripts/server-only-stub.js --outfile=dist/owner-recover.cjs",
    "owner:recover": "NODE_OPTIONS=--conditions=react-server dotenv -e .env -- tsx scripts/owner-recover.ts",
    "backup:drill": "NODE_OPTIONS=--conditions=react-server tsx scripts/restore-drill.ts",
    "admin:create": "NODE_OPTIONS=--conditions=react-server dotenv -e .env -- tsx scripts/admin-create.ts",
    "auth:generate": "esbuild server/auth/cli.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-stub.js --outfile=node_modules/.cache/auth-cli/cli.mjs && dotenv -e .env -- pnpm dlx auth@1.7.7 generate --config node_modules/.cache/auth-cli/cli.mjs --output server/db/schema/auth.ts -y && node scripts/auth-schema-tz.mjs server/db/schema/auth.ts && prettier --write server/db/schema/auth.ts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server dotenv -e .env -- tsx scripts/seed.ts",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:tracking": "playwright test --config playwright.tracking.config.ts",
    "test:e2e:appearance": "playwright test --config playwright.appearance.config.ts",
    "test:e2e:ai": "playwright test --config playwright.ai.config.ts",
    "e2e:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/e2e-seed.ts",
    "test:parity": "playwright test tests/e2e/parity",
    "test:parity:update": "playwright test tests/e2e/parity --update-snapshots",
    "test:visual:linux": "scripts/visual-baselines-linux.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/google": "4.0.82",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@ai-sdk/react": "4.0.119",
    "@aws-sdk/client-s3": "3.1141.0",
    "@base-ui/react": "^1.8.0",
    "@bsmnt/scrollytelling": "^0.3.3",
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@gsap/react": "^2.1.2",
    "@hono/vercel": "1.0.1",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "9.2.8",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "ai": "7.0.116",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "culori": "4.0.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "gsap": "^3.15.0",
    "hono": "4.13.13",
    "lenis": "^1.3.26",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "^1.51.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "nuqs": "^2.10.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-colorful": "5.8.1",
    "react-dom": "19.2.8",
    "react-easy-crop": "6.2.3",
    "react-email": "6.11.0",
    "react-hook-form": "7.89.0",
    "react-is": "19.2.8",
    "recharts": "3.8.0",
    "resend": "6.30.0",
    "schema-dts": "2.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@react-email/ui": "6.11.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/culori": "4.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "otpauth": "^9.5.2",
    "postcss": "8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
