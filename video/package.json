{
  "name": "promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "60-second promo video for the website, built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/promo.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts Promo out/still.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
