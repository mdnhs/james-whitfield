# Copy to .env for local development: cp .env.example .env
SITE_URL=http://localhost:3000
SITE_ENV=development
DATABASE_URL=postgres://mk:mk@localhost:5432/mk_dev

# Test databases (created by docker/postgres/init)
DATABASE_URL_TEST=postgres://mk:mk@localhost:5432/mk_test
DATABASE_URL_E2E=postgres://mk:mk@localhost:5432/mk_e2e

# Email: "smtp" delivers to Mailpit locally (http://localhost:8025)
EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Magda Kennedy <hello@localhost>"

# Auth: generate a secret with `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Scheduler tick bearer (>= 32 chars). openssl rand -hex 32
CRON_SECRET=

# Docker/Dokploy: the container reads these at runtime.
# Required in production: SITE_URL, SITE_ENV, DATABASE_URL, BETTER_AUTH_SECRET,
# BETTER_AUTH_URL, EMAIL_DRIVER, SMTP_URL (until Phase 6), EMAIL_FROM,
# CRON_SECRET.

# Media (docs/brief.md §14). "local" stores uploads in MEDIA_LOCAL_DIR (mount a
# persistent volume there in Docker) and serves them from /uploads.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage
# "s3" stores uploads in Cloudflare R2 (EU jurisdiction endpoint, from
# S3_ACCOUNT_ID) or any S3 endpoint (S3_ENDPOINT, path-style; e.g. a local
# RustFS emulator). MEDIA_PUBLIC_URL is the bucket's public https URL (http is
# allowed only when SITE_ENV=development). It is
# also read at BUILD time by next.config.ts for next/image remotePatterns:
# in Dokploy pass MEDIA_PUBLIC_URL as a build arg as well as a runtime env.
# MEDIA_DRIVER=s3
# MEDIA_PUBLIC_URL=https://media.example.com
# S3_ACCOUNT_ID=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
